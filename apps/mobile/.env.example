# Financial Hub Mobile - Environment Variables
# Copy this file to .env.local and fill in your values.
# EXPO_PUBLIC_* values are inlined into the app bundle — never put the
# Supabase service role key (or any other server secret) here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# API base URL (must include /api). One backend per EAS profile (M9) —
# eas.json sets this per profile at build time; .env.local overrides it for
# local `expo start` runs only.
#   development → local API:      http://localhost:3000/api
#     (Android emulator: http://10.0.2.2:3000/api — emulator localhost is
#      the emulated device, not your machine. Physical device: your LAN IP,
#      e.g. http://192.168.1.X:3000/api)
#   preview     → staging API:    https://api-staging-f91bc.up.railway.app/api
#     (requires the Railway staging service to exist — provision it before
#      shipping preview builds, or they will fail closed with no backend)
#   production  → production API: https://api-production-f91bc.up.railway.app/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Push notifications (Batch 7)
# EAS project UUID from https://expo.dev → your project → Project settings.
# Required for remote Expo push tokens. Local notifications still work without it.
# Also paste the same value into apps/mobile/app.json → expo.extra.eas.projectId
# ---------------------------------------------------------------------------
EXPO_PUBLIC_EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Crash reporting (Batch 7 audit)
# Leave blank locally if you do not have a Sentry project yet — mobile
# no-ops when this is unset.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=
