# Financial Hub API - Environment Variables
# Copy this file to .env.local and fill in your values

# App
NODE_ENV=development
PORT=3000

# Supabase (for database and auth)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# Comma-separated CORS allowlist; overrides FRONTEND_URL when set
CORS_ORIGINS=http://localhost:8081,https://shakeable-joanne-nodose.ngrok-free.dev

# Set to 'true' to expose Swagger docs when NODE_ENV=production (off by default)
ENABLE_SWAGGER=false

# ---------------------------------------------------------------------------
# Observability / crash reporting (Batch 7 audit)
# Leave blank locally if you do not have a Sentry project yet — the API
# no-ops when SENTRY_DSN is unset.
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Railway production (set in dashboard Variables / `railway variables`)
# Same keys as above — SUPABASE_*, JWT_*, CORS_ORIGINS, FRONTEND_URL, SENTRY_DSN
# After deploy, EXPO_PUBLIC_API_URL on mobile should be:
#   https://api-production-8db1.up.railway.app/api
# ---------------------------------------------------------------------------
